{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "supabaseUrl",
      "type": "promptString",
      "description": "URL de tu instancia de Supabase"
    },
    {
      "id": "supabaseAnonKey",
      "type": "promptString",
      "description": "Anon key de tu instancia de Supabase",
      "password": true
    },
    {
      "id": "squatTrace",
      "type": "pickString",
      "description": "Traza de sentadillas por cuadro (solo debug)",
      "options": ["false", "true"],
      "default": "false"
    }
  ],
  "configurations": [
    {
      "name": "RivalFit (Supabase local)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SUPABASE_URL=${input:supabaseUrl}",
        "--dart-define=SUPABASE_ANON_KEY=${input:supabaseAnonKey}",
        "--dart-define=TRAINING_SYNC_ENABLED=true",
        "--dart-define=LEAGUE_WEEKLY_RANKING_ENABLED=true",
        "--dart-define=SQUAT_TRACE=${input:squatTrace}"
      ]
    }
  ]
}
