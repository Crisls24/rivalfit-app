{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "supabaseUrl",
      "type": "promptString",
      "description": "URL de tu instancia de Supabase"
    },
    {
      "id": "supabaseAnonKey",
      "type": "promptString",
      "description": "Anon key de tu instancia de Supabase",
      "password": true
    }
  ],
  "configurations": [
    {
      "name": "RivalFit (Supabase local)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SUPABASE_URL=${input:supabaseUrl}",
        "--dart-define=SUPABASE_ANON_KEY=${input:supabaseAnonKey}"
      ]
    }
  ]
}