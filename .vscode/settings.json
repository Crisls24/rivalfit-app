{
  "dart.flutterSdkPath": ".fvm/flutter_sdk",
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/.fvm/**"
  ],
  "search.exclude": {
    "**/.fvm": true
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  }
}
